# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
# ⚠️ Secreta: solo se usa en el servidor para crear usuarios desde el panel admin. NUNCA con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Resend (resend.com > API Keys)
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=Tecmelec <notificaciones@tudominio.com>

# Business Central (Azure AD app registration con acceso a la API de BC)
BC_TENANT_ID=tu-tenant-id
BC_CLIENT_ID=tu-client-id
BC_CLIENT_SECRET=tu-client-secret
BC_ENVIRONMENT=Production
BC_COMPANY_NAME=Tecmelec Electricidad S.L.
BC_ODATA_SERVICE=Ficha_producto_Excel
BC_ODATA_SERVICE_PROYECTOS=Ficha_proyecto_Excel
BC_ODATA_SERVICE_PROVEEDORES=Prov
BC_ODATA_SERVICE_PEDIDOS_COMPRA=Pedido_compra_Excel
BC_ODATA_SERVICE_LINEAS_COMPRA=Purchase_Order_Line_Excel
BC_ODATA_SERVICE_TAREAS_PROYECTO=Job_Task_Lines
BC_ODATA_SERVICE_LINEAS_PLANIFICACION=Líneas_de_planificación_de_proyecto_Excel
BC_ODATA_SERVICE_FICHA_PROVEEDOR=Ficha_proveedor_Excel
BC_ODATA_SERVICE_BANCO_PROVEEDOR=Ficha_banco_proveedor_Excel

# Solo si el correo @tecmelec.es vive en un tenant de Microsoft 365 distinto
# al de Business Central; si no se rellenan, se reutilizan las de arriba.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# Secreto para autenticar las llamadas al cron de sincronización con BC
# (Vercel lo envía automáticamente como Authorization: Bearer <valor> al
# invocar el cron; genera una cadena aleatoria de 16+ caracteres).
CRON_SECRET=una-cadena-aleatoria-larga
