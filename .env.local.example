# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
# ⚠️ Secreta: solo se usa en el servidor para crear usuarios desde el panel admin. NUNCA con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Resend (resend.com > API Keys)
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=Tecmelec <notificaciones@tudominio.com>

# Business Central (Azure AD app registration con acceso a la API de BC)
BC_TENANT_ID=tu-tenant-id
BC_CLIENT_ID=tu-client-id
BC_CLIENT_SECRET=tu-client-secret
BC_ENVIRONMENT=Production
BC_COMPANY_NAME=Tecmelec Electricidad S.L.
BC_ODATA_SERVICE=Ficha_producto_Excel
